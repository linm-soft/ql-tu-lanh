<UserControl x:Class="Tulanh.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F2F2F2">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock Text="TỦ LẠNH THÔNG MINH"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Chào mừng bạn đến với hệ thống quản lý tủ lạnh"
                       FontSize="18"
                       Margin="0,15,0,30"
                       HorizontalAlignment="Center"/>

            <Button Content="Quản lý thức ăn"
                    Width="220"
                    Height="50"
                    FontSize="17"
                    Click="OpenFoodManagement_Click"/>

        </StackPanel>

    </Grid>

</UserControl>