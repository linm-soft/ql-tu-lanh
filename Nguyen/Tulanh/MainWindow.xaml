<Window x:Class="Tulanh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tủ lạnh thông minh"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F2F2F2">

        <!-- Chia giao diện thành menu và nội dung -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- MENU BÊN TRÁI -->
        <Border Grid.Column="0"
                Background="#263238">

            <StackPanel>

                <TextBlock Text="TỦ LẠNH THÔNG MINH"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="10,40,10,40"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>


                <!-- BUTTON MỞ TRANG QUẢN LÝ THỨC ĂN -->
                <Button x:Name="btnQLThucAn" Content="Quản lý thức ăn"
                        Height="50"
                        Margin="15,10"
                        FontSize="16"
                        Click="OpenFoodManagement_Click"/>


                <Button Content="Trang chủ"
                        Height="50"
                        Margin="15,10"
                        FontSize="16"
                        Click="OpenHome_Click"/>

                <Button Content="Cài đặt"
                        Height="50"
                        Margin="15,10"
                        FontSize="16"/>

            </StackPanel>

        </Border>


        <!-- KHU VỰC HIỂN THỊ TRANG -->
        <Grid Grid.Column="1">

            <ContentControl x:Name="MainContent"/>

        </Grid>

    </Grid>

</Window>