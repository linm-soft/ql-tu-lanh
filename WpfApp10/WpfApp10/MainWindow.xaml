<Window x:Class="WpfApp10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp10"
        mc:Ignorable="d"
        Title="Block Blast — Lớp 8"
        Height="860" Width="560"
        MinHeight="760" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F4F7FB">
    <Window.Resources>
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BLOCK BLAST"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2A37"/>
                <TextBlock Text="Chọn một khối, rồi bấm ô trên bàn cờ để đặt."
                           Margin="0,4,0,0"
                           Foreground="#5C6B7A"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Chơi lại"
                    Style="{StaticResource PlayButton}"
                    VerticalAlignment="Center"
                    Click="NewGame_Click"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,10" Background="White" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtMessage"
                           Text="Chọn một khối ở bên dưới."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="#34495E"/>
                <TextBlock x:Name="txtScore"
                           Grid.Column="1"
                           Text="Điểm: 0"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#E67E22"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Width="500"
                Height="500"
                Margin="0,14"
                Padding="8"
                Background="White"
                CornerRadius="16"
                BorderBrush="#D6DEE8"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <UniformGrid x:Name="gameBoard" Rows="8" Columns="8"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Border x:Name="slot0"
                    Width="120" Height="120" Margin="8" Padding="12"
                    CornerRadius="12" Background="White"
                    BorderBrush="#95A5A6" BorderThickness="3"
                    Cursor="Hand" Tag="0"
                    MouseLeftButtonUp="Slot_Click">
                <UniformGrid x:Name="preview0" Rows="2" Columns="2"/>
            </Border>
            <Border x:Name="slot1"
                    Width="120" Height="120" Margin="8" Padding="12"
                    CornerRadius="12" Background="White"
                    BorderBrush="#95A5A6" BorderThickness="3"
                    Cursor="Hand" Tag="1"
                    MouseLeftButtonUp="Slot_Click">
                <UniformGrid x:Name="preview1" Rows="2" Columns="2"/>
            </Border>
            <Border x:Name="slot2"
                    Width="120" Height="120" Margin="8" Padding="12"
                    CornerRadius="12" Background="White"
                    BorderBrush="#95A5A6" BorderThickness="3"
                    Cursor="Hand" Tag="2"
                    MouseLeftButtonUp="Slot_Click">
                <UniformGrid x:Name="preview2" Rows="2" Columns="2"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>