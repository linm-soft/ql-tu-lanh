<UserControl x:Class="Tulanh.Views.FoodManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>


        <!-- FORM NHẬP / SỬA THỰC PHẨM -->

        <Border Grid.Column="0"
                Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="0,0,20,0">

            <StackPanel>

                <TextBlock Text="Nhập Thực Phẩm Mới"
                           FontSize="20"
                           FontWeight="Bold"/>


                <!-- TÊN -->

                <TextBlock Text="Tên thực phẩm"
                           Margin="0,20,0,5"/>

                <TextBox x:Name="txtName"
                         Height="40"/>


                <!-- PHÂN LOẠI -->

                <TextBlock Text="Phân loại"
                           Margin="0,15,0,5"/>

                <ComboBox x:Name="cbCategory"
                          Height="40">

                    <ComboBoxItem Content="Thịt tươi sống"/>
                    <ComboBoxItem Content="Rau củ"/>
                    <ComboBoxItem Content="Đồ uống"/>
                    <ComboBoxItem Content="Thực phẩm đông lạnh"/>

                </ComboBox>


                <!-- NGĂN CHỨA -->

                <TextBlock Text="Xếp vào ngăn chứa"
                           Margin="0,15,0,5"/>

                <ComboBox x:Name="cbCompartment"
                          Height="40">

                    <ComboBoxItem Content="Ngăn mát"/>
                    <ComboBoxItem Content="Ngăn đông"/>
                    <ComboBoxItem Content="Ngăn rau củ"/>

                </ComboBox>


                <!-- SỐ LƯỢNG + TRỌNG LƯỢNG -->

                <Grid Margin="0,15,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Số lượng"/>

                        <TextBox x:Name="txtQuantity"
                                 Height="40"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">

                        <TextBlock Text="Trọng lượng (Gram)"/>

                        <TextBox x:Name="txtWeight"
                                 Height="40"/>

                    </StackPanel>

                </Grid>


                <!-- NGÀY NHẬP + SỐ NGÀY TƯƠI -->

                <Grid Margin="0,15,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Ngày nhập"/>

                        <DatePicker x:Name="dpImportDate"
                                    Height="40"/>

                    </StackPanel>


                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">

                        <TextBlock Text="Số ngày tươi ngon"/>

                        <TextBox x:Name="txtFreshDays"
                                 Height="40"/>

                    </StackPanel>

                </Grid>


                <!-- NÚT LƯU / CẬP NHẬT -->

                <Button Content="Lưu Vào Tủ Lạnh"
                        Height="45"
                        Margin="0,25,0,0"
                        Background="#39B872"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnSave_Click"/>

            </StackPanel>

        </Border>


        <!-- DANH SÁCH THỰC PHẨM -->

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="15"
                Padding="25">

            <StackPanel>

                <TextBlock Text="Trạng Thái Kho Thực Phẩm"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>


                <DataGrid x:Name="FoodDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">


                    <DataGrid.Columns>


                        <!-- TÊN -->

                        <DataGridTextColumn
                            Header="Tên Thực Phẩm"
                            Binding="{Binding Name}"/>


                        <!-- PHÂN LOẠI -->

                        <DataGridTextColumn
                            Header="Phân loại"
                            Binding="{Binding Category}"/>


                        <!-- NGĂN -->

                        <DataGridTextColumn
                            Header="Ngăn Chứa"
                            Binding="{Binding Compartment}"/>


                        <!-- SỐ LƯỢNG -->

                        <DataGridTextColumn
                            Header="Số lượng / Trọng lượng"
                            Binding="{Binding QuantityWeight}"/>


                        <!-- TRẠNG THÁI -->

                        <DataGridTextColumn
                            Header="Trạng Thái"
                            Binding="{Binding FreshStatus}"/>


                        <!-- SỬA + XÓA -->

                        <DataGridTemplateColumn Header="Thao tác">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <!-- NÚT SỬA -->

                                        <Button Content="Sửa"
                                                Background="Orange"
                                                Foreground="White"
                                                Padding="10,5"
                                                Margin="0,0,5,0"
                                                Click="btnEdit_Click"/>


                                        <!-- NÚT XÓA -->

                                        <Button Content="Xóa"
                                                Background="Red"
                                                Foreground="White"
                                                Padding="10,5"
                                                Click="btnDelete_Click"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>


                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>