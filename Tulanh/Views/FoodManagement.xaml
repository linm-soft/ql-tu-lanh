<UserControl x:Class="Tulanh.Views.FoodManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="30">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================= -->
        <!-- FORM NHẬP THỰC PHẨM -->
        <!-- ========================= -->

        <Border Grid.Column="0"
                Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="0,0,20,0">

            <StackPanel>

                <!-- TIÊU ĐỀ -->
                <TextBlock Text="Quản Lý Thực Phẩm"
                           FontSize="20"
                           FontWeight="Bold"/>


                <!-- TÊN THỰC PHẨM -->
                <TextBlock Text="Tên thực phẩm"
                           Margin="0,20,0,5"/>

                <TextBox x:Name="txtName"
                         Height="40"/>


                <!-- PHÂN LOẠI -->
                <TextBlock Text="Phân loại"
                           Margin="0,15,0,5"/>

                <ComboBox x:Name="cbCategory"
                          Height="40">

                    <ComboBoxItem Content="Thịt tươi sống"/>
                    <ComboBoxItem Content="Rau củ"/>
                    <ComboBoxItem Content="Đồ uống"/>
                    <ComboBoxItem Content="Thực phẩm đông lạnh"/>

                </ComboBox>


                <!-- NGĂN CHỨA -->
                <TextBlock Text="Xếp vào ngăn chứa"
                           Margin="0,15,0,5"/>

                <ComboBox x:Name="cbCompartment"
                          Height="40">

                    <ComboBoxItem Content="Ngăn mát"/>
                    <ComboBoxItem Content="Ngăn đông"/>
                    <ComboBoxItem Content="Ngăn rau củ"/>

                </ComboBox>


                <!-- SỐ LƯỢNG + TRỌNG LƯỢNG -->
                <Grid Margin="0,15,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <!-- SỐ LƯỢNG -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Số lượng"/>

                        <TextBox x:Name="txtQuantity"
                                 Height="40"/>

                    </StackPanel>


                    <!-- TRỌNG LƯỢNG -->
                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">

                        <TextBlock Text="Trọng lượng (Gram)"/>

                        <TextBox x:Name="txtWeight"
                                 Height="40"/>

                    </StackPanel>

                </Grid>


                <!-- NGÀY NHẬP + SỐ NGÀY TƯƠI -->
                <Grid Margin="0,15,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>


                    <!-- NGÀY NHẬP -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Ngày nhập"/>

                        <DatePicker x:Name="dpImportDate"
                                    Height="40"/>

                    </StackPanel>


                    <!-- SỐ NGÀY TƯƠI -->
                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,0">

                        <TextBlock Text="Số ngày tươi ngon"/>

                        <TextBox x:Name="txtFreshDays"
                                 Height="40"/>

                    </StackPanel>

                </Grid>


                <!-- ========================= -->
                <!-- NÚT THÊM MỚI -->
                <!-- ========================= -->

                <StackPanel x:Name="AddButtons"
                            Orientation="Horizontal"
                            Margin="0,25,0,0">

                    <Button Content="Thêm"
                            Width="120"
                            Height="45"
                            Background="#39B872"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,10,0"
                            Click="btnAdd_Click"/>

                    <Button Content="Hủy"
                            Width="120"
                            Height="45"
                            Click="btnCancel_Click"/>

                </StackPanel>


                <!-- ========================= -->
                <!-- NÚT CẬP NHẬT -->
                <!-- ========================= -->

                <StackPanel x:Name="EditButtons"
                            Orientation="Horizontal"
                            Margin="0,25,0,0"
                            Visibility="Collapsed">

                    <Button Content="Cập nhật"
                            Width="120"
                            Height="45"
                            Background="Orange"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,10,0"
                            Click="btnUpdate_Click"/>

                    <Button Content="Hủy"
                            Width="120"
                            Height="45"
                            Click="btnCancel_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>


        <!-- ========================= -->
        <!-- DANH SÁCH THỰC PHẨM -->
        <!-- ========================= -->

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="15"
                Padding="25">

            <StackPanel>

                <!-- TIÊU ĐỀ -->
                <TextBlock Text="Trạng Thái Kho Thực Phẩm"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>


                <!-- DATAGRID -->
                <DataGrid x:Name="FoodDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column">


                    <DataGrid.Columns>


                        <!-- TÊN -->
                        <DataGridTextColumn
                            Header="Tên Thực Phẩm"
                            Binding="{Binding Name}"/>


                        <!-- PHÂN LOẠI -->
                        <DataGridTextColumn
                            Header="Phân loại"
                            Binding="{Binding Category}"/>


                        <!-- NGĂN -->
                        <DataGridTextColumn
                            Header="Ngăn Chứa"
                            Binding="{Binding Compartment}"/>


                        <!-- SỐ LƯỢNG / TRỌNG LƯỢNG -->
                        <DataGridTextColumn
                            Header="Số lượng / Trọng lượng"
                            Binding="{Binding QuantityWeight}"/>


                        <!-- TRẠNG THÁI -->
                        <DataGridTextColumn
                            Header="Trạng Thái"
                            Binding="{Binding FreshStatus}"/>


                        <!-- ========================= -->
                        <!-- NÚT THAO TÁC -->
                        <!-- ========================= -->

                        <DataGridTemplateColumn Header="Thao tác">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <!-- CHỈNH SỬA -->
                                        <Button Content="Chỉnh sửa"
                                                Background="Orange"
                                                Foreground="White"
                                                Padding="10,5"
                                                Margin="0,0,5,0"
                                                Click="btnEdit_Click"/>


                                        <!-- XÓA -->
                                        <Button Content="Xóa"
                                                Background="Red"
                                                Foreground="White"
                                                Padding="10,5"
                                                Click="btnDelete_Click"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>